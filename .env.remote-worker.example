# Copy to .env.remote-worker on each Apple-Silicon Mac.
# The Worker talks only to the Center control API. It does NOT need PostgreSQL,
# Redis or object-storage credentials. Internet deployments MUST use HTTPS.
#
# Internet example. After V3 enrollment this can also be omitted because the
# agent stores the Center API address in its local non-secret config.
REMOTE_WORKER_API_BASE=https://worker-api.example.com/api/saas/internal/render
# Trusted LAN example remains supported:
# REMOTE_WORKER_API_BASE=http://192.168.1.10:8918/api/saas/internal/render
# Only use this escape hatch for a trusted private network with a non-private DNS name.
# REMOTE_WORKER_ALLOW_INSECURE_HTTP=1
# Preferred V3 flow: do not put the long-lived Worker token in this file.
# Run remote_worker_agent enroll once; the token is stored in macOS Keychain.
# REMOTE_WORKER_TOKEN=PASTE_WORKER_TOKEN_HERE
REMOTE_WORKER_NAME=m4-mini-01

# Compatibility gate reported to the center.
REMOTE_WORKER_CODE_VERSION=0.5.0
REMOTE_WORKER_MODEL_VERSION=musetalk-mlx
# Explicitly pin existing Apple-Silicon workers to the MLX backend.
REMOTE_WORKER_RENDER_BACKEND=mlx
REMOTE_WORKER_RENDER_CONTRACT_VERSION=v1

# One compute slot per 16GB mini. Cross-page TTS prefetch stays disabled.
SAAS_TTS_PREFETCH=0

# Content-addressed local cache and transfer limits.
REMOTE_WORKER_CACHE_DIR=./workspace/remote-worker-cache
REMOTE_WORKER_CACHE_GB=20
REMOTE_WORKER_MIN_DISK_FREE_GB=10
REMOTE_WORKER_TRANSFER_SLOTS=2
REMOTE_WORKER_UPLOAD_CHUNK_MB=8
REMOTE_WORKER_HTTP_TIMEOUT_SECONDS=120

# When the Center enables SAAS_DISTRIBUTED_DIRECT_DOWNLOADS=true, the task
# manifest may contain short-lived S3/OSS/COS signed URLs. The Worker downloads
# those with a separate unauthenticated client and automatically falls back to
# the authenticated Center proxy if the direct URL is unavailable.

# Keep the same production model-quality parameters as the center Mac.
MUSETALK_RESIDENT_RUNTIME=1
MUSETALK_BATCH_SIZE=auto
MUSETALK_VIDEO_ENCODER=auto
