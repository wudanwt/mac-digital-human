# ==============================================================================
# Mac Digital Human SaaS - Production Environment Configuration Template
# Adheres strictly to docs/SYNOLOGY_M4_PRODUCTION_DEPLOYMENT.md and SaaSSettings.
# Copy to .env.production on Synology NAS and generate unique secrets.
# ==============================================================================

# Core environment: production validation enforces non-local storage, explicit hosts, etc.
SAAS_ENV=production
SAAS_API_PREFIX=/api/saas
SAAS_APP_NAME="Digital Human SaaS Studio"

# Host & Ports on Synology NAS
SAAS_API_HOST_PORT=8918
# Portainer already uses 9000 on Synology; default to 9005 for MinIO S3 API
MINIO_HOST_PORT=9005
MINIO_CONSOLE_HOST_PORT=9006

# Persistent storage paths on Synology NAS (MUST be on /volume3 to avoid full /volume1)
SAAS_PROD_POSTGRES_DIR=/volume3/docker/mac-digital-human/postgres_data
SAAS_PROD_REDIS_DIR=/volume3/docker/mac-digital-human/redis_data
SAAS_PROD_MINIO_DIR=/volume3/docker/mac-digital-human/minio_data
SAAS_SHARED_WORKSPACE_DIR=/volume3/docker/mac-digital-human/workspace
SAAS_SHARED_OUTPUTS_DIR=/volume3/docker/mac-digital-human/outputs

# PostgreSQL credentials (internal to Docker network)
SAAS_DB_NAME=digital_human
SAAS_DB_USER=digital_human
# Generate with: openssl rand -hex 16
SAAS_DB_PASSWORD=GENERATE_STRONG_RANDOM_PASSWORD_FOR_DB

# Queue transport (Redis)
WORKER_BACKEND=redis
SAAS_QUEUE_NAME=avatar:render
SAAS_QUEUE_STALE_SECONDS=7200
WORKER_POLL_TIMEOUT_SECONDS=5
SAAS_ALLOW_LOCAL_FALLBACK=false

# Authentication & Security
# SAAS_JWT_SECRET MUST be a unique random 32+ character string.
# Generate with: openssl rand -base64 36
SAAS_JWT_SECRET=GENERATE_UNIQUE_RANDOM_32_PLUS_CHARACTERS_JWT_SECRET
SAAS_JWT_ALGORITHM=HS256
SAAS_ACCESS_TOKEN_MINUTES=1440
# Production MUST be false until email verification is enabled.
# Create initial users with: python -m app.saas.manage create-user ...
SAAS_ALLOW_PUBLIC_REGISTRATION=false
# Comma-separated admin emails
SAAS_ADMIN_EMAILS=admin@example.com

# Domain, CORS, and Trusted Hosts
# Must not be "*" or include localhost in production.
# Replace with your actual domain or NAS IP/hostname.
SAAS_TRUSTED_HOSTS=nas.5dpc.top,192.168.1.234
SAAS_CORS_ORIGINS=https://nas.5dpc.top,http://192.168.1.234:8918

# Object Storage: minio (required in production, local disk is rejected)
STORAGE_BACKEND=minio
STORAGE_BUCKET=digital-human
# Endpoint reachable by API/Distributed Center inside container (or reverse proxy)
STORAGE_ENDPOINT=http://minio:9000
# Browser-accessible MinIO origin. For LAN deployments, use the NAS address and published port.
STORAGE_PUBLIC_BASE_URL=http://192.168.1.234:9005
# MinIO bucket data stays private. CORS applies only to valid presigned URLs.
MINIO_API_CORS_ALLOW_ORIGIN=*
# MinIO Root / Service credentials. Generate with openssl rand -hex 16
STORAGE_ACCESS_KEY=admin
STORAGE_SECRET_KEY=GENERATE_STRONG_SECRET_FOR_MINIO
STORAGE_SIGNED_URL_SECONDS=3600
STORAGE_REGION=us-east-1

# Page-Level Distributed Rendering Engine
SAAS_DISTRIBUTED_RENDER_ENABLED=true
SAAS_DISTRIBUTED_LEASE_SECONDS=120
SAAS_DISTRIBUTED_RENEW_SECONDS=10
SAAS_DISTRIBUTED_REAPER_SECONDS=15
SAAS_DISTRIBUTED_MAX_ATTEMPTS=3
SAAS_DISTRIBUTED_STALL_SECONDS=1200
SAAS_RENDER_CONTRACT_VERSION=v1
SAAS_DISTRIBUTED_CACHE_GB=20
SAAS_DISTRIBUTED_MIN_DISK_FREE_GB=10
SAAS_DISTRIBUTED_TRANSFER_SLOTS=2
SAAS_DISTRIBUTED_UPLOAD_CHUNK_MB=8
# Enable direct downloads/uploads once signed URL reverse proxy is verified
SAAS_DISTRIBUTED_DIRECT_DOWNLOADS=false
SAAS_DISTRIBUTED_DIRECT_UPLOADS=false
SAAS_DISTRIBUTED_ENROLLMENT_MINUTES=30

# Compliance & Product Settings
SAAS_REQUIRE_AI_LABEL=true
SAAS_AI_LABEL_TEXT=AI生成
SAAS_PAYMENT_PROVIDERS=manual
SAAS_MAX_UPLOAD_MB=500
SAAS_RATE_LIMIT_PER_MINUTE=120
SAAS_FREE_PLAN_MINUTES=30
SAAS_DEFAULT_RENDER_ESTIMATE_SECONDS=60
SAAS_MAX_FREE_WORKSPACES_PER_USER=1
