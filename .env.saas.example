# Core
SAAS_ENV=development
SAAS_API_PREFIX=/api/saas
SAAS_APP_NAME=Digital Human SaaS Studio
DATABASE_URL=postgresql+psycopg://digital_human:digital_human@postgres:5432/digital_human
REDIS_URL=redis://redis:6379/0
SAAS_QUEUE_NAME=avatar:render

# Authentication - production must use a random 32+ character secret
SAAS_JWT_SECRET=replace-with-a-long-random-production-secret
SAAS_JWT_ALGORITHM=HS256
SAAS_ACCESS_TOKEN_MINUTES=1440
# Comma-separated emails that should receive platform superuser permissions
SAAS_ADMIN_EMAILS=

# Queue transport. Use redis in containers/production.
WORKER_BACKEND=redis
WORKER_POLL_TIMEOUT_SECONDS=5
SAAS_ALLOW_LOCAL_FALLBACK=false

# Renderer implementation selected inside the worker image.
# Mac development: mlx-local
# No-GPU end-to-end smoke test: mock
# Linux GPU production target: cuda-musetalk
SAAS_RENDERER=mock

# Storage: local | s3 | oss | cos | minio
STORAGE_BACKEND=local
STORAGE_BUCKET=digital-human
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_PUBLIC_BASE_URL=
STORAGE_LOCAL_ROOT=/app/workspace/saas-assets
STORAGE_SIGNED_URL_SECONDS=3600

# Product/security
SAAS_MAX_UPLOAD_MB=500
SAAS_RATE_LIMIT_PER_MINUTE=120
SAAS_CORS_ORIGINS=http://localhost:8918,http://127.0.0.1:8918
SAAS_TRUSTED_HOSTS=*
SAAS_FREE_PLAN_MINUTES=30
SAAS_DEFAULT_RENDER_ESTIMATE_SECONDS=60
