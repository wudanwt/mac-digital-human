# Core
SAAS_ENV=development
SAAS_API_PREFIX=/api/saas
SAAS_APP_NAME=Digital Human SaaS Studio
DATABASE_URL=postgresql+psycopg://digital_human:digital_human@postgres:5432/digital_human
REDIS_URL=redis://redis:6379/0
SAAS_QUEUE_NAME=avatar:render
SAAS_QUEUE_STALE_SECONDS=7200

# Local Docker <-> Mac host bridge
SAAS_DB_NAME=digital_human
SAAS_DB_USER=digital_human
SAAS_DB_PASSWORD=local-dev-only-password
SAAS_POSTGRES_HOST_PORT=5432
SAAS_REDIS_HOST_PORT=6379
SAAS_SHARED_WORKSPACE_DIR=./workspace
SAAS_SHARED_OUTPUTS_DIR=./outputs
# Optional explicit host-side overrides used by scripts/saas/start_mlx_worker_mac.sh
SAAS_HOST_DATABASE_URL=
SAAS_HOST_REDIS_URL=
SAAS_HOST_STORAGE_ROOT=

# Authentication
# Generate a UNIQUE random 32+ character value for production. Do not copy an example secret.
SAAS_JWT_SECRET=CHANGE_ME_WITH_A_UNIQUE_RANDOM_SECRET
SAAS_JWT_ALGORITHM=HS256
SAAS_ACCESS_TOKEN_MINUTES=1440
# Development may use true. Production MUST use false until email verification is implemented.
# Provision production users with: python -m app.saas.manage create-user ...
SAAS_ALLOW_PUBLIC_REGISTRATION=true
# Reserved administrator emails. Public registration can never claim these addresses.
SAAS_ADMIN_EMAILS=

# Queue transport. Use redis in containers/production.
WORKER_BACKEND=redis
WORKER_POLL_TIMEOUT_SECONDS=5
SAAS_ALLOW_LOCAL_FALLBACK=false

# Renderer implementation selected inside the worker process.
# Mac development: mlx-local
# No-GPU end-to-end smoke test: mock
# Linux GPU target (intentionally skipped until CUDA validation): cuda-musetalk
SAAS_RENDERER=mock

# Storage: local | s3 | oss | cos | minio
# Production validation rejects local storage.
STORAGE_BACKEND=local
STORAGE_BUCKET=digital-human
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_PUBLIC_BASE_URL=
# Docker path. The Mac worker startup script maps the same object keys to ./workspace/saas-assets.
STORAGE_LOCAL_ROOT=/app/workspace/saas-assets
STORAGE_SIGNED_URL_SECONDS=3600

# Product/security
SAAS_MAX_UPLOAD_MB=500
SAAS_RATE_LIMIT_PER_MINUTE=120
SAAS_CORS_ORIGINS=http://localhost:8918,http://127.0.0.1:8918
SAAS_TRUSTED_HOSTS=*
SAAS_FREE_PLAN_MINUTES=30
SAAS_DEFAULT_RENDER_ESTIMATE_SECONDS=60
SAAS_MAX_FREE_WORKSPACES_PER_USER=1

# Payment
# Only manual settlement is production-ready in this branch.
SAAS_PAYMENT_PROVIDERS=manual

# AI-generated content labeling
SAAS_REQUIRE_AI_LABEL=true
SAAS_AI_LABEL_TEXT=AI生成
