# Linux + NVIDIA CUDA remote Worker.
# This file is separate from .env.remote-worker.example so existing Mac workers
# keep their current MLX defaults unchanged.

REMOTE_WORKER_API_BASE=https://worker-api.example.com/api/saas/internal/render
# Provision with:
#   python -m app.saas.manage create-worker --name cuda-worker-01 --slots 1
REMOTE_WORKER_TOKEN=PASTE_WORKER_TOKEN_HERE
REMOTE_WORKER_NAME=cuda-worker-01

REMOTE_WORKER_CODE_VERSION=0.5.0
REMOTE_WORKER_MODEL_VERSION=musetalk-cuda
REMOTE_WORKER_RENDER_CONTRACT_VERSION=v1
REMOTE_WORKER_RENDER_BACKEND=cuda

REMOTE_WORKER_CACHE_DIR=./workspace/remote-worker-cache-cuda
REMOTE_WORKER_CACHE_GB=40
REMOTE_WORKER_MIN_DISK_FREE_GB=20
REMOTE_WORKER_TRANSFER_SLOTS=2
REMOTE_WORKER_UPLOAD_CHUNK_MB=8
REMOTE_WORKER_HTTP_TIMEOUT_SECONDS=120

# Official MuseTalk 1.5 CUDA runtime, installed by scripts/cloud/setup_musetalk_cuda.sh.
MUSETALK_CUDA_DIR=./vendor/MuseTalk-CUDA
MUSETALK_CONDA_ENV=musetalk-cuda
MUSETALK_CUDA_GPU_ID=0
MUSETALK_CUDA_BATCH_SIZE=8
MUSETALK_CUDA_FP16=1

SAAS_TTS_PREFETCH=0
